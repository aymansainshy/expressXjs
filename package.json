{
  "name": "expressxjs",
  "private": true,
  "workspaces": [
    "core",
    "cli",
    "examples"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=examples",
    "dev2": "npm run dev2 --workspace=examples",
    "build": "npm run build --workspace=@expressxjs/core && npm run build --workspace=@expressxjs/cli",
    "build:core": "npm run build --workspace=@expressxjs/core",
    "build:cli": "npm run build --workspace=@expressxjs/cli",
    "format": "prettier --config .prettierrc --ignore-path .prettierignore --write .",
    "format:check": "prettier --config .prettierrc --ignore-path .prettierignore --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
